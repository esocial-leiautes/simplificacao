<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns="http://www.esocial.gov.br/schema/evt/evtContDecJud/v_S_01_03_00" targetNamespace="http://www.esocial.gov.br/schema/evt/evtContDecJud/v_S_01_03_00" xmlns:ds="http://www.w3.org/2000/09/xmldsig#" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
    <xs:include schemaLocation="tipos.xsd" />
    <xs:import namespace="http://www.w3.org/2000/09/xmldsig#" schemaLocation="xmldsig-core-schema.xsd" />
    <xs:element name="eSocial">
        <xs:annotation>
            <xs:documentation>S-8501 - Informações de Contribuições Sociais Decorrentes de Decisão Judicial</xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="evtContDecJud">
                    <xs:annotation>
                        <xs:documentation>Evento Informações de Contribuições Sociais Decorrentes de Decisão Judicial.</xs:documentation>
                        <xs:documentation>CHAVE_GRUPO: {Id}</xs:documentation>
                        <xs:documentation>REGRA:REGRA_ENVIO_PROC_FECHAMENTO</xs:documentation>
                        <xs:documentation>REGRA:REGRA_EXC_RET_8501</xs:documentation>
                        <xs:documentation>REGRA:REGRA_EXISTE_INFO_EMPREGADOR</xs:documentation>
                        <xs:documentation>REGRA:REGRA_RETIFICA_IDENTIFICADOR</xs:documentation>
                        <xs:documentation>REGRA:REGRA_VALIDA_EMPREGADOR</xs:documentation>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="ideEvento" type="T_ideEvento_trab_jud" />
                            <xs:element name="ideEmpregador" type="T_ideEmpregador" />
                            <xs:element name="ideProc">
                                <xs:annotation>
                                    <xs:documentation>Identificação do processo.</xs:documentation>
                                    <xs:documentation>CHAVE_GRUPO: {nrProcTrab*}, {perApurPgto*}, {ideSeqProc*}</xs:documentation>
                                </xs:annotation>
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="nrProcTrab" type="TS_nrProcTrab">
                                            <xs:annotation>
                                                <xs:documentation>Número do processo trabalhista.</xs:documentation>
                                                <xs:documentation>Validação: Deve ser um número de processo válido e declarado no evento S-2500 ou S-8500 para o(s) trabalhador(es) informado(s) em {cpfTrab}(8501_ideTrab_cpfTrab).</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element name="alvara" type="TS_texto_20">
                                            <xs:annotation>
                                                <xs:documentation>Número do alvará judicial.</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element name="perApurPgto" type="TS_periodo_mensal">
                                            <xs:annotation>
                                                <xs:documentation>Mês/ano em que é devida a obrigação de pagar a parcela prevista no acordo/sentença.</xs:documentation>
                                                <xs:documentation>Validação: Deve ser um período igual ou posterior ao mês/ano de {dtSent} existente no evento S-2500 ou S-8500 para o processo indicado em {nrProcTrab}(./nrProcTrab).</xs:documentation>
                                                <xs:documentation>Deve ser informado no formato AAAA-MM.</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element name="ideSeqProc" minOccurs="0">
                                            <xs:annotation>
                                                <xs:documentation>Número sequencial atribuído a cada conjunto de dados de contribuições sociais decorrentes de processo trabalhista, quando for necessário enviar o mesmo processo em múltiplos S-8501, para o mesmo {}(./perApurPgto).</xs:documentation>
                                                <xs:documentation>Validação: Deve ser um identificador único dentre os eventos S-8501 do empregador que tenham os mesmos {}(./nrProcTrab) e {}(./perApurPgto).</xs:documentation>
                                                <xs:documentation>Se for preenchido, não pode haver outro evento S-8501 com os mesmos {}(./nrProcTrab) e {}(./perApurPgto) e sem o campo {}(./ideSeqProc).</xs:documentation>
                                                <xs:documentation>Se não for preenchido, não pode haver outro evento S-8501 com os mesmos {}(./nrProcTrab) e {}(./perApurPgto).</xs:documentation>
                                                <xs:documentation>O valor [0] é reservado para uso interno.</xs:documentation>
                                            </xs:annotation>
                                            <xs:simpleType>
                                                <xs:restriction base="xs:positiveInteger">
                                                    <xs:pattern value="\d{1,3}" />
                                                </xs:restriction>
                                            </xs:simpleType>
                                        </xs:element>
                                        <xs:element name="obs" minOccurs="0" type="TS_texto_999">
                                            <xs:annotation>
                                                <xs:documentation>Observação referente ao pagamento de parcela prevista no acordo/sentença.</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="ideTrab" maxOccurs="unbounded">
                                <xs:annotation>
                                    <xs:documentation>Identificação do trabalhador.</xs:documentation>
                                    <xs:documentation>CHAVE_GRUPO: {cpfTrab}</xs:documentation>
                                </xs:annotation>
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="calcTrib" minOccurs="0" maxOccurs="999">
                                            <xs:annotation>
                                                <xs:documentation>Identificação do período e da base de cálculo dos tributos.</xs:documentation>
                                                <xs:documentation>CHAVE_GRUPO: {perRef}</xs:documentation>
                                                <xs:documentation>CONDICAO_GRUPO: OC</xs:documentation>
                                            </xs:annotation>
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="infoCRContrib" minOccurs="0" maxOccurs="99">
                                                        <xs:annotation>
                                                            <xs:documentation>Informações das contribuições sociais.</xs:documentation>
                                                            <xs:documentation>DESCRICAO_COMPLETA:Informações das contribuições sociais devidas à Previdência Social e Outras Entidades e Fundos, por Código de Receita - CR.</xs:documentation>
                                                            <xs:documentation>CHAVE_GRUPO: {tpCR}</xs:documentation>
                                                            <xs:documentation>CONDICAO_GRUPO: OC</xs:documentation>
                                                        </xs:annotation>
                                                        <xs:complexType>
                                                            <xs:attribute name="tpCR" use="required">
                                                                <xs:annotation>
                                                                    <xs:documentation>Código de Receita - CR relativo a contribuições sociais devidas à Previdência Social e a Outras Entidades e Fundos (Terceiros), conforme legislação em vigor na competência.</xs:documentation>
                                                                    <xs:documentation>Validação: Deve ser um código válido e existente na Tabela 29.</xs:documentation>
                                                                </xs:annotation>
                                                                <xs:simpleType>
                                                                    <xs:restriction base="xs:integer">
                                                                        <xs:pattern value="\d{6}" />
                                                                    </xs:restriction>
                                                                </xs:simpleType>
                                                            </xs:attribute>
                                                            <xs:attribute name="vrCR" use="required">
                                                                <xs:annotation>
                                                                    <xs:documentation>Valor correspondente ao Código de Receita - CR.</xs:documentation>
                                                                    <xs:documentation>Validação: Deve ser informado de acordo com a legislação em vigor na competência.</xs:documentation>
                                                                    <xs:documentation>Deve ser maior que 0 (zero).</xs:documentation>
                                                                </xs:annotation>
                                                                <xs:simpleType>
                                                                    <xs:restriction base="TS_valorMonetario_positivo" />
                                                                </xs:simpleType>
                                                            </xs:attribute>
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:sequence>
                                                <xs:attribute name="perRef" use="required">
                                                    <xs:annotation>
                                                        <xs:documentation>Informar o mês/ano (formato AAAA-MM) de referência das informações.</xs:documentation>
                                                        <xs:documentation>Validação: Deve ser um período existente no evento S-2500 ou S-8500 para o trabalhador indicado em {cpfTrab}(../cpfTrab) (observado o campo {ideSeqTrab}(2500_ideTrab_ideSeqTrab) de S-2500, se existente, ou o campo {matricula}(8500_ideTrab_matricula) de S-8500), igual ou posterior a [2008-12] e igual ou anterior a {perApurPgto}(8501_ideProc_perApurPgto).</xs:documentation>
                                                    </xs:annotation>
                                                    <xs:simpleType>
                                                        <xs:restriction base="TS_periodo_mensal" />
                                                    </xs:simpleType>
                                                </xs:attribute>
                                                <xs:attribute name="vrBcCpMensal" use="required">
                                                    <xs:annotation>
                                                        <xs:documentation>Valor da base de cálculo da contribuição previdenciária sobre a remuneração mensal do trabalhador.</xs:documentation>
                                                        <xs:documentation>Validação: Deve ser maior ou igual a 0 (zero).</xs:documentation>
                                                    </xs:annotation>
                                                    <xs:simpleType>
                                                        <xs:restriction base="TS_valorMonetario" />
                                                    </xs:simpleType>
                                                </xs:attribute>
                                                <xs:attribute name="vrBcCp13" use="required">
                                                    <xs:annotation>
                                                        <xs:documentation>Valor da base de cálculo da contribuição previdenciária sobre a remuneração do trabalhador referente ao 13º salário.</xs:documentation>
                                                        <xs:documentation>Validação: Deve ser maior ou igual a 0 (zero).</xs:documentation>
                                                    </xs:annotation>
                                                    <xs:simpleType>
                                                        <xs:restriction base="TS_valorMonetario" />
                                                    </xs:simpleType>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                    <xs:attribute name="cpfTrab" use="required">
                                        <xs:annotation>
                                            <xs:documentation>Preencher com o número do CPF do trabalhador.</xs:documentation>
                                            <xs:documentation>Validação: Deve ser um CPF válido e informado no evento S-2500 ou S-8500.</xs:documentation>
                                            <xs:documentation>Deve ser único dentre os eventos S-8501 que tenham os mesmos {}(../ideProc_nrProcTrab) e {}(../ideProc_perApurPgto).</xs:documentation>
                                        </xs:annotation>
                                        <xs:simpleType>
                                            <xs:restriction base="TS_cpfTrab" />
                                        </xs:simpleType>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                        <xs:attribute name="Id" use="required" type="TS_Id" />
                    </xs:complexType>
                </xs:element>
                <xs:element ref="ds:Signature" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>